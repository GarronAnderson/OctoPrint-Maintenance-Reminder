<a href="javascript:void(0)"
   title="Maintenance Reminder"
   class="dropdown-toggle pull-right"
   data-toggle="dropdown"
   id="navbar_maintenance_reminder"
   data-bind="css: needsMaintenance() ? 'text-danger' : 'text-success'">

    <span class="fa-layers fa-fw">
        <i class="fas fa-screwdriver-wrench"></i>
        <i class="fas fa-circle"
           data-fa-transform="shrink-6 right-6 up-3"
           style="color: #ff0000"
           data-bind="visible: needsMaintenance">
        </i>
    </span>

    <span data-bind="
        visible: pluginSettings.show_navbar_message,
        text: needsMaintenance()
            ? _('Maintenance Recommended')
            : _('No Maintenance Recommended'),
        style: { color: needsMaintenance() ? 'red' : '' }
    "></span>

    <b class="caret"></b>
</a>

<ul class="dropdown-menu dropdown-menu-right maintenance-dropdown">

    <li>
        <table class="table table-striped maintenance-table">
            <tbody data-bind="foreach: pluginSettings.reminders">

                <tr data-bind="
                    css: $parent.isAlert($data)
                        ? 'maintenance-alert maintenance-row'
                        : 'maintenance-row'
                ">
                    <td data-bind="text: message"></td>

                    <td style="text-align: right; white-space: nowrap;">
                        <span data-bind="text: count"></span>
                        /
                        <span data-bind="text: interval"></span>
                        prints

                        <button type="button"
                                class="btn btn-mini btn-success reminder-reset"
                                data-bind="
                                    attr: { 'data-index': $index() }
                                ">
                            <i class="fa fa-check-square"></i>
                            {{ _('Mark Complete') }}
                        </button>
                    </td>
                </tr>

                <tr>
                    <td colspan="2">
                        <div class="progress">
                            <div class="bar"
                                 data-bind="
                                     css: $parent.barClass($data),
                                     style: {
                                         width: $parent.percentage($data) + '%'
                                     },
                                     text: $parent.percentage($data) + '%'
                                 ">
                            </div>
                        </div>
                    </td>
                </tr>

            </tbody>
        </table>
    </li>

</ul>
